{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "webhookCertificateSecretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
    },
    "requiredWebhookCertificateCABundle": {
      "type": "string",
      "minLength": 1
    },
    "webhookCertificateSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName"
      ],
      "properties": {
        "secretName": {
          "$ref": "#/definitions/webhookCertificateSecretName"
        }
      }
    },
    "webhookCertificateTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "azureWorkloadIdentity"
      ],
      "properties": {
        "operator": {
          "$ref": "#/definitions/webhookCertificateSecret"
        },
        "azureWorkloadIdentity": {
          "$ref": "#/definitions/webhookCertificateSecret"
        }
      }
    },
    "selfManagedWebhookCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretName",
        "caBundle"
      ],
      "properties": {
        "secretName": {
          "type": "string"
        },
        "caBundle": {
          "type": "string"
        }
      }
    },
    "requiredSelfManagedWebhookCertificate": {
      "type": "object",
      "required": [
        "secretName",
        "caBundle"
      ],
      "properties": {
        "secretName": {
          "$ref": "#/definitions/webhookCertificateSecretName"
        },
        "caBundle": {
          "$ref": "#/definitions/requiredWebhookCertificateCABundle"
        }
      }
    },
    "selfManagedWebhookCertificateTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "azureWorkloadIdentity"
      ],
      "properties": {
        "operator": {
          "$ref": "#/definitions/selfManagedWebhookCertificate"
        },
        "azureWorkloadIdentity": {
          "$ref": "#/definitions/selfManagedWebhookCertificate"
        }
      }
    }
  },
  "required": [
    "azure",
    "manager",
    "telemetry",
    "serviceAccount",
    "global",
    "azureWorkloadIdentityWebhook"
  ],
  "properties": {
    "webhook": false,
    "azure": {
      "type": "object",
      "required": [
        "tenantId",
        "subscriptionId",
        "resourceGroupName",
        "location",
        "credentials"
      ],
      "properties": {
        "tenantId": {
          "type": "string"
        },
        "subscriptionId": {
          "type": "string",
          "minLength": 1
        },
        "resourceGroupName": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "keys"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "keys": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "clientId",
                    "tenantId",
                    "clientSecret"
                  ],
                  "properties": {
                    "clientId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^[-._a-zA-Z0-9]+$",
                      "not": {
                        "anyOf": [
                          {
                            "enum": [
                              "."
                            ]
                          },
                          {
                            "pattern": "^\\.\\."
                          }
                        ]
                      }
                    },
                    "tenantId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^[-._a-zA-Z0-9]+$",
                      "not": {
                        "anyOf": [
                          {
                            "enum": [
                              "."
                            ]
                          },
                          {
                            "pattern": "^\\.\\."
                          }
                        ]
                      }
                    },
                    "clientSecret": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 253,
                      "pattern": "^[-._a-zA-Z0-9]+$",
                      "not": {
                        "anyOf": [
                          {
                            "enum": [
                              "."
                            ]
                          },
                          {
                            "pattern": "^\\.\\."
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "manager": {
      "type": "object",
      "required": [
        "replicas",
        "podDisruptionBudget",
        "refreshIntervals",
        "image",
        "extraEnv",
        "extraVolumes",
        "extraVolumeMounts"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "podDisruptionBudget": {
          "type": "object",
          "required": [
            "enabled",
            "minAvailable"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]?|100)%$"
                }
              ]
            }
          }
        },
        "refreshIntervals": {
          "type": "object",
          "required": [
            "oidcIssuer",
            "workloadIdentity"
          ],
          "properties": {
            "oidcIssuer": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "workloadIdentity": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mountPath"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mountPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracing"
      ],
      "properties": {
        "tracing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "create": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webhookCertificates"
      ],
      "properties": {
        "webhookCertificates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "certManager",
            "openShiftServiceCA",
            "selfManaged"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "certManager",
                "openShiftServiceCA",
                "selfManaged"
              ]
            },
            "certManager": {
              "$ref": "#/definitions/webhookCertificateTargets"
            },
            "openShiftServiceCA": {
              "$ref": "#/definitions/webhookCertificateTargets"
            },
            "selfManaged": {
              "$ref": "#/definitions/selfManagedWebhookCertificateTargets"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "provider": {
                    "const": "selfManaged"
                  }
                }
              },
              "then": {
                "properties": {
                  "selfManaged": {
                    "properties": {
                      "operator": {
                        "$ref": "#/definitions/requiredSelfManagedWebhookCertificate"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "azureWorkloadIdentityWebhook": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount",
        "namespaceOverride",
        "podDisruptionBudget",
        "service"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "namespaceOverride": {
          "type": "string",
          "const": "microsoft-azure-workload-identity-webhook-system"
        },
        "disableCertRotation": false,
        "certManagerCertificateName": false,
        "certificates": false,
        "podDisruptionBudget": {
          "type": "object",
          "required": [
            "enabled",
            "minAvailable"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^([1-9][0-9]?|100)%$"
                }
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "azureWorkloadIdentityWebhook": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "azure": {
            "properties": {
              "tenantId": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "azureWorkloadIdentityWebhook": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "global": {
            "properties": {
              "webhookCertificates": {
                "properties": {
                  "provider": {
                    "const": "selfManaged"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "global": {
            "properties": {
              "webhookCertificates": {
                "properties": {
                  "selfManaged": {
                    "properties": {
                      "azureWorkloadIdentity": {
                        "$ref": "#/definitions/requiredSelfManagedWebhookCertificate"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
